# Install: edit ExecStart's --server below to your own libretro-artwork-api
#          host/port first (192.168.1.100 below is a placeholder), then:
#          sudo cp random-art-display.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now random-art-display

[Unit]
Description=Random game art display (Turing USB-C screen)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osmc
WorkingDirectory=/home/osmc/random-art-display
ExecStart=/usr/bin/python3 /home/osmc/random-art-display/random_art_display.py --server http://192.168.1.100:8478 --interval 20 --type boxart --system n64,snes --orientation landscape --no-allow-square-images
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
